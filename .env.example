# ---- General ----
NG_ENV=development
NG_LOG_LEVEL=INFO
NG_WORKSPACE_DIR=./.ng_workspaces
NG_ARCHIVE_DIR=./archive
NG_SECRET_KEY=change-this-long-random-admin-secret

# ---- HTTP server ----
NG_HTTP_HOST=0.0.0.0
NG_HTTP_PORT=8080

# ---- GitHub ----
NG_GITHUB_WEBHOOK_SECRET=change-me
NG_GITHUB_APP_TOKEN=ghp_xxx
NG_GITHUB_ALLOWED_REPOS=acme/payments,acme/checkout
NG_GITHUB_TRIGGER_LABEL=negotium

# ---- Discord ----
NG_DISCORD_BOT_TOKEN=
NG_DISCORD_GUILD_ALLOWLIST=
NG_DISCORD_CHANNEL_MAP_PATH=./config/channel_map.yml

# ---- LLM ----
NG_LLM_DEFAULT_ROUTE=cloud
NG_LLM_PROVIDER=solar
# Upstage Solar (기본 클라우드 provider) — https://console.upstage.ai 에서 키 발급
NG_SOLAR_API_KEY=
NG_SOLAR_MODEL=solar-open2
NG_SOLAR_BASE_URL=https://api.upstage.ai/v1
NG_OPENAI_API_KEY=sk-...
NG_OPENAI_MODEL=gpt-4o-mini
NG_OPENAI_BASE_URL=
NG_ANTHROPIC_API_KEY=
NG_ANTHROPIC_MODEL=claude-3-5-sonnet-latest
NG_GEMINI_API_KEY=
NG_GEMINI_MODEL=gemini-1.5-flash
NG_TOGETHER_API_KEY=
NG_TOGETHER_MODEL=openai/gpt-oss-20b
NG_TOGETHER_BASE_URL=https://api.together.ai/v1
NG_VLLM_BASE_URL=http://localhost:8000/v1
NG_VLLM_MODEL=Qwen/Qwen3-4B
# embedded = vLLM이 FastAPI와 같은 프로세스에서 GPU로 직접 로드 (권장).
# http     = 외부 OpenAI 호환 vLLM 서버에 NG_VLLM_BASE_URL 로 붙음.
NG_VLLM_MODE=embedded
NG_VLLM_DTYPE=bfloat16
NG_VLLM_MAX_MODEL_LEN=8192
NG_VLLM_GPU_MEMORY_UTILIZATION=0.9
NG_VLLM_ENFORCE_EAGER=false
NG_VLLM_TRUST_REMOTE_CODE=true
NG_VLLM_WORKER_MULTIPROC_METHOD=spawn
NG_LOCAL_LLM_BASE_URL=http://localhost:8000/v1

# ---- Agent graph ----
NG_MAX_SELF_CORRECTION=2
NG_EVENT_QUEUE_SIZE=100
